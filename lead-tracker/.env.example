# Expat Lead Tracker — environment variables
# Copy to .env.local (Next.js) and fill in. The URL + publishable key are safe to
# expose to the browser: every data-access rule is enforced by Postgres RLS.

NEXT_PUBLIC_SUPABASE_URL=https://zuoekghumuphilkygqks.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SDwpJSPp6ah7KLfOqAgbYQ_ZJCj35Oq

# Server-only. NEVER expose to the client or commit the real value.
# Used by server actions/route handlers that must bypass RLS (e.g. the cron
# notification scan trigger, admin-only maintenance). Get it from:
# Supabase dashboard -> Project Settings -> API -> service_role secret.
SUPABASE_SERVICE_ROLE_KEY=

